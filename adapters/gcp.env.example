# ITC531 Module 7 GCP adapter configuration (real values, no real credentials).
# Copy to gcp.env, generate JWT_SECRET locally, never commit gcp.env.
ENVIRONMENT=cloud
CLI=gcloud
GCP_PROJECT=itc531-module7
GCP_REGION=us-central1
SERVICE_NAME=itc531-mypipeline
IMAGE_REF=docker.io/marshaun06/mypipeline:0b10d59
CONTAINER_PORT=8000
MIN_INSTANCES=0
MAX_INSTANCES=1
CPU=1
MEMORY=512Mi
TIMEOUT=30s
SERVICE_ACCOUNT=itc531-m7-storage@itc531-module7.iam.gserviceaccount.com
HMAC_CREDENTIAL_FILE=adapters/gcp-hmac-private.json
S3_ENDPOINT_URL=https://storage.googleapis.com
S3_REGION=auto
S3_BUCKET=
DATABASE_URL=
AMQP_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
CORS_ORIGINS='["https://itc531-mypipeline-284041991449.us-central1.run.app"]'
SPEND_ALERT_THRESHOLD=5
BUDGET_NAME='$5 Monthly Budget Alert'
