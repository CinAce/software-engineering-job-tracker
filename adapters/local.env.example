# Local environment example
# Replace each description with the correct local value.
# Do not commit real credentials.

# RabbitMQ
BROKER_USER=<local RabbitMQ username>
BROKER_PASSWORD=<local RabbitMQ password>

# Object Storage
S3_ENDPOINT_URL=<internal S3-compatible endpoint used by the application>
S3_PUBLIC_ENDPOINT_URL=<S3-compatible endpoint reachable by the client>
S3_BUCKET=<object storage bucket name>
S3_REGION=<object storage region>
AWS_ACCESS_KEY_ID=<local object storage access key>
AWS_SECRET_ACCESS_KEY=<local object storage secret key>