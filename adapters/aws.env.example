# AWS adapter configuration — example only
# Copy to adapters/aws.env and customize.
# AWS credentials are read from ~/.aws/credentials.

ENVIRONMENT=cloud
IMAGE_REF="python:3.12.11-slim-bookworm"
SERVICE_NAME=itc531-myauth
CLI=aws

AWS_PROFILE=itc531
AWS_DEFAULT_REGION=us-east-2

S3_BUCKET=itc531-myauth-bucket
S3_REGION=us-east-2
S3_ENDPOINT_URL=https://s3.us-east-2.amazonaws.com

DATABASE_URL=
AMQP_URL=

JWT_ALGORITHM=HS256
CORS_ORIGINS='["https://your-service-url"]'

SPEND_ALERT_THRESHOLD=5
AWS_BUDGET_NAME="My Monthly Cost Budget"
