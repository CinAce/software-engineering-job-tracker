# Adapter: local — Rancher Desktop on your own machine.
#
# This is the only adapter the course ships complete. It is used for modules 1-8
# and it is what every tutorial runs against. Modules 6-8 add a second adapter
# that YOU write for a provider YOU choose.
#
# Nothing here costs money and nothing here leaves your machine.

ENVIRONMENT=local

# --- C2: S3-compatible object storage ---------------------------------------
S3_ENDPOINT_URL=http://storage:9000
S3_BUCKET=itc531-local
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=itc531minio
AWS_SECRET_ACCESS_KEY=itc531minio-devonly

# --- relational --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://itc531:itc531-devonly@db:5432/itc531

# --- messaging ---------------------------------------------------------------
AMQP_URL=amqp://itc531:itc531-devonly@broker:5672/

# --- security ----------------------------------------------------------------
# Local development value only. `bash scripts/doctor.sh` fails if this string appears in an
# adapter whose ENVIRONMENT is not "local".
JWT_SECRET=local-development-secret-do-not-use-anywhere-else-32b
JWT_ALGORITHM=HS256

# Single-quoted deliberately. Compose's env_file strips the outer quotes, so the
# app receives valid JSON either way. Without them, `set -a; source` — which the
# module 6-8 cloud scripts use — applies shell quote removal and the app would get
# [http://localhost:3000,http://localhost:8000], which is not JSON, and startup
# would fail with a settings error that points nowhere near this line.
CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'
